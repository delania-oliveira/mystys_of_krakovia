; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mystys Of Krakovia"
run/main_scene="uid://dqws0gwxk1adc"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Network="*res://network/network.gd"
MonsterHelper="*res://helpers/monster.gd"
CharacterHelper="*res://helpers/character.gd"
Globals="*res://globals/Globals.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Mystys Of Krakovia"

[editor_plugins]

enabled=PackedStringArray("res://addons/GPUTrail/plugin.cfg", "res://addons/godot_colyseus/plugin.cfg", "res://addons/terrain_3d/plugin.cfg", "res://addons/zylann.hterrain/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://scenes/": "green",
"res://shaders/": "purple"
}

